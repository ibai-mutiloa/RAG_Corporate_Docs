# ==================================
# Configuración de Base de Datos
# ==================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=normativas_db
DB_USER=normativas_user
DB_PASS=tu_password

# ==================================
# Configuración de Procesamiento
# ==================================
BASE_DIR=~/normativas
IGNORE_DIRS=NormativasAPP
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_TOKENS_PER_CHUNK=2000

# ==================================
# Azure OpenAI - Modelo de Embeddings
# ==================================
AZURE_ENDPOINT=https://tu-recurso.openai.azure.com/
AZURE_API_KEY=tu_api_key_embeddings
AZURE_DEPLOYMENT_NAME=text-embedding-3-small
AZURE_API_VERSION=2024-12-01-preview

# ==================================
# Azure OpenAI - Modelo de Texto/Chat (GPT)
# ==================================
# Nombre del deployment del modelo de texto (ej: gpt-4, gpt-35-turbo, gpt-4o)
AZURE_DEPLOYMENT_NAME_TEXT=gpt-4

# Si usas el mismo endpoint y API key que para embeddings, no necesitas configurar estos:
AZURE_ENDPOINT_TEXT=
AZURE_API_KEY_TEXT=

# Si usas un endpoint o API key diferente, configúralos aquí:
# AZURE_ENDPOINT_TEXT=https://otro-recurso.openai.azure.com/
# AZURE_API_KEY_TEXT=tu_api_key_texto

# ==================================
# Configuración de la API
# ==================================
API_PORT=5000
API_DEBUG=False
TOP_K=5
